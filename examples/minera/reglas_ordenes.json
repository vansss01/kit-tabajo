{
  "columns": {
    "orden": {
      "required": true,
      "nonempty": true,
      "unique": true
    },
    "equipo": {
      "required": true,
      "nonempty": true
    },
    "tipo": {
      "required": true,
      "allowed": [
        "preventiva",
        "correctiva",
        "inspección"
      ]
    },
    "prioridad": {
      "required": true,
      "allowed": [
        "alta",
        "media",
        "baja"
      ]
    },
    "fecha_apertura": {
      "required": true,
      "nonempty": true,
      "type": "date"
    },
    "fecha_cierre": {
      "type": "date"
    },
    "horas": {
      "required": true,
      "nonempty": true,
      "type": "number",
      "decimal": ",",
      "min": "0",
      "max": "72"
    },
    "estado": {
      "required": true,
      "nonempty": true,
      "allowed": [
        "abierta",
        "cerrada",
        "en proceso"
      ]
    }
  }
}
